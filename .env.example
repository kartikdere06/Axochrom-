# --- Database ---
# For local dev, SQLite needs no setup:
DATABASE_URL="file:./dev.db"
# For production, switch schema.prisma datasource provider to "postgresql" and use:
# DATABASE_URL="postgresql://user:password@host:5432/axochrome"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use test keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
# From https://dashboard.stripe.com/webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
